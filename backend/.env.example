# Database
# For Docker-compose, set DATABASE_URL to: postgresql://USER:PASSWORD@db:5432/DATABASE
# For local development without Docker:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# JWT
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# File Uploads
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
DEBUG=false

# PostgreSQL Docker-compose variables (optional)
# POSTGRES_DB=itms
# POSTGRES_USER=itms_user
# POSTGRES_PASSWORD=itms_pass

# AI Gateway / LLM (Phase 4)
# AI_PROVIDER=gemini  # or ollama
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# OLLAMA_MODEL=llama3.2
# AI_TEMPERATURE=0.0
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TIMEOUT_SECONDS=30
