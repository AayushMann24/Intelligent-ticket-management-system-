# Database
# For Docker-compose, set DATABASE_URL to: postgresql://USER:PASSWORD@db:5432/DATABASE
# For local development without Docker:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# JWT
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# File Uploads
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
DEBUG=false

# PostgreSQL Docker-compose variables (optional)
# POSTGRES_DB=itms
# POSTGRES_USER=itms_user
# POSTGRES_PASSWORD=itms_pass
