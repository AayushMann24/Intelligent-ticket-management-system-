# Database
# For Docker-compose, set DATABASE_URL to: postgresql://USER:PASSWORD@db:5432/DATABASE
# For local development without Docker:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# JWT
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# File Uploads
UPLOAD_DIR=./uploads

# Environment
ENVIRONMENT=development
DEBUG=false

# PostgreSQL Docker-compose variables (optional)
# POSTGRES_DB=itms
# POSTGRES_USER=itms_user
# POSTGRES_PASSWORD=itms_pass

# AI Gateway / LLM (Phase 4)
# AI_PROVIDER=gemini  # or ollama
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# OLLAMA_MODEL=llama3.2
# AI_TEMPERATURE=0.0
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TIMEOUT_SECONDS=30

# Email Delivery / SMTP (Phase 2D-4)
# EMAIL_PROVIDER controls escalation email delivery.
#   mock    -> logs emails only (default; used by development and tests)
#   console -> prints emails to stdout
#   smtp    -> sends real email through the SMTP server below
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=noreply@itms.local
EMAIL_FROM_NAME=ITMS Notifications

# SMTP settings (only used when EMAIL_PROVIDER=smtp).
# Keep credentials out of version control. Never log or expose SMTP_PASSWORD.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT_SECONDS=10
